{
  "name": "@react-aria/mcp",
  "version": "1.2.1",
  "description": "MCP server for React Aria documentation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/react-spectrum"
  },
  "bin": "dist/mcp/react-aria/src/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/mcp/react-aria/src/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "yarn build",
    "build": "tsc -p tsconfig.json && chmod +x dist/mcp/react-aria/src/index.js",
    "start": "node dist/mcp/react-aria/src/index.js",
    "dev": "node --enable-source-maps dist/mcp/react-aria/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "rsp": {
    "type": "cli"
  }
}
