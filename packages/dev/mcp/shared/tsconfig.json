{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "types": ["node"],
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*", "../../agent-docs-core/src/**/*"],
  "exclude": ["dist", "node_modules", "s2/dist", "react-aria/dist"]
}
