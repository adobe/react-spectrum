{
  "extends": ["../../../parcel-v3/.parcelrc-icons", "@parcel/config-default"],
  "resolvers": ["@parcel/resolver-glob", "..."],
  "transformers": {
    "docs:*": [
      {
        "plugin": "@parcel/transformer-native",
        "config": {
          "lib": "/Users/devongovett/dev/ts-doc-rs/target/release/libparcel_ts_doc.dylib"
        }
      }
    ],
    "packages/**/intl/**/*.json": ["parcel-transformer-intl"],
    "url:*.svg": ["@parcel/transformer-svg", "@parcel/transformer-raw"],
    "data-url:*.svg": ["@parcel/transformer-svg", "@parcel/transformer-inline"],
    "starters/tailwind/**/*.css": ["@parcel/transformer-tailwind", "..."],
    "packages/dev/s2-docs/tailwind/*.css": ["@parcel/transformer-tailwind", "..."],
    "*.mdx": ["./MDXTransformer.mjs", "..."]
  },
  "bundler": {
    "plugin": "@parcel/bundler-default",
    "config": {
      "manualSharedBundles": [
        {
          "assets": [
            "packages/@react-spectrum/s2/**",
            "packages/dev/s2-docs/src/**",
            "packages/dev/s2-docs/pages/s2/**/*.{mdx,tsx,ts,js}"
          ],
          "types": ["css"]
        }
      ]
    }
  }
}
